SEARCH_DATABASE_URL=postgresql+asyncpg://search:anything@localhost:55432/search
SEARCH_SYNC_DATABASE_URL=postgresql+psycopg://search:anything@localhost:55432/search
SEARCH_STORAGE_ENDPOINT=http://localhost:9000
SEARCH_STORAGE_REGION=us-east-1
SEARCH_STORAGE_ACCESS_KEY=search-local
SEARCH_STORAGE_SECRET_KEY=search-local-secret
SEARCH_STORAGE_BUCKET=search-anything
SEARCH_EMBEDDING_MODEL_PATH=~/.cache/huggingface/hub/models--google--embeddinggemma-2/snapshots/914f7f89142e33e77833254d9c9b90c3cef7303b
SEARCH_EMBEDDING_MODEL_REVISION=914f7f89142e33e77833254d9c9b90c3cef7303b
SEARCH_EMBEDDING_CONTEXT_TOKENS=8192
SEARCH_EMBEDDING_BATCH_SIZE=8
SEARCH_EMBEDDING_DEVICE=auto
SEARCH_CHUNK_TARGET_TOKENS=700
SEARCH_CHUNK_OVERLAP_TOKENS=80
SEARCH_OCR_LANGUAGES=eng
SEARCH_WHISPER_CHECKPOINT_PATH=~/.cache/whisper/tiny.pt
SEARCH_WHISPER_MODEL_NAME=tiny
SEARCH_WHISPER_DEVICE=cpu
RUSTFS_ACCESS_KEY=search-local
RUSTFS_SECRET_KEY=search-local-secret

# Retain completed/failed search results for this many hours.
SEARCH_QUERY_RETENTION_HOURS=24

# Wait up to this many seconds for search results, 0 disables waiting (max 5).
SEARCH_QUERY_WAIT_SECONDS=5

# Embedding inference runs in the standalone service; tokenization stays local.
SEARCH_EMBEDDING_BACKEND=api
SEARCH_EMBEDDING_API_URL=http://127.0.0.1:8001
# JSON list; empty disables auth. The worker sends the first key.
SEARCH_EMBEDDING_API_KEYS=[]
SEARCH_EMBEDDING_API_TIMEOUT_SECONDS=120
